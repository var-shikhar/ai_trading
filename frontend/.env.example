# Copy to .env and adjust. Dev-server settings only: nothing here is sent to
# the browser, and no secrets belong here (Fyers keys live in backend/.env).

# Where the FastAPI backend runs; /api requests are forwarded to it.
BACKEND_URL=http://127.0.0.1:8000

# Port for `npm run dev` / `npm run preview`. If you change it, also update
# FRONTEND_URL and CORS_ORIGINS in backend/.env (used after Fyers login).
PORT=5173
