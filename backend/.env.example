# Copy to .env and fill in. Never commit .env.

# Storage
DB_PATH=data/market.duckdb

# Frontend dev server (CORS + where login redirects back to)
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# Candle data (swing setup): 15m base candles kept for this many days;
# older 30m/1h/2h/4h ranges are fetched directly from the API instead.
INTRADAY_BASE_DAYS=730
# Min seconds between API refreshes of today's candles for a symbol
REFRESH_SECONDS=60

# Fyers (step 2) - create an app at https://myapi.fyers.in
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://127.0.0.1:8000/api/auth/fyers/callback

# Kotak Neo (later)
KOTAK_CONSUMER_KEY=
KOTAK_CONSUMER_SECRET=

# App login (no public sign-up). Create accounts with:
#   .venv\Scripts\python -m app.cli create-user <name>
# or set these once: the account is created on startup if no user exists.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# When hosted over HTTPS:
COOKIE_SECURE=false
TRUST_PROXY=false
