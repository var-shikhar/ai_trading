# Copy to .env and fill in. Never commit .env.

# Storage
DB_PATH=data/market.duckdb

# Frontend dev server allowed by CORS
CORS_ORIGINS=["http://localhost:5173"]

# Fyers (step 2) - create an app at https://myapi.fyers.in
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://127.0.0.1:8000/api/auth/fyers/callback

# Kotak Neo (later)
KOTAK_CONSUMER_KEY=
KOTAK_CONSUMER_SECRET=
