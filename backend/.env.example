# Copy to .env and fill in. Never commit .env.
# Any setting left out uses the default shown here.

# --- Server (python -m app.serve) --------------------------------------------
# Keep 127.0.0.1 behind Caddy/Nginx; 0.0.0.0 exposes it on every interface.
HOST=127.0.0.1
PORT=8000

# --- Storage --------------------------------------------------------------------
DB_PATH=data/market.duckdb

# --- Frontend address (CORS + where you land after the Fyers login) -------------
# Locally the Vite dev server; when hosted, your domain (see bottom).
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# --- Candle data (swing setup) ------------------------------------------------------
# 15m base candles kept for this many days; older 30m/1h/2h/4h ranges are
# fetched directly from the API instead.
INTRADAY_BASE_DAYS=730
# Min seconds between API refreshes of today's candles for a symbol
REFRESH_SECONDS=60

# --- Fyers: create an app at https://myapi.fyers.in ---------------------------------
# The redirect URL must match the one set on the Fyers app exactly.
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://127.0.0.1:8000/api/auth/fyers/callback

# --- Kotak Neo (not used yet) ---------------------------------------------------------
KOTAK_CONSUMER_KEY=
KOTAK_CONSUMER_SECRET=

# --- App login (no public sign-up) -------------------------------------------------
# The first admin: create it with (server stopped), then add other users from
# the app (account menu -> Manage users):
#   .venv\Scripts\python -m app.cli create-user <name>
# or fill these in: the account is created on startup if no user exists yet
# (you can clear them afterwards). Password: at least 8 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
# Send the session cookie over HTTPS only. Set true when hosted with HTTPS.
COOKIE_SECURE=false
# Behind Caddy/Nginx on the same machine: use the visitor's real address
# (X-Forwarded-For) for login throttling. Set true when hosted behind a proxy.
TRUST_PROXY=false
# Keep true. false turns the login off entirely (only for automated tests).
AUTH_REQUIRED=true

# --- Alerts ---------------------------------------------------------------------------
# The alert engine runs inside the backend. Keep true (false is for tests).
ALERTS_ENABLED=true
# Optional notification channels (in-app alerts always work while the app is open).
# Telegram: message @BotFather -> /newbot, put the token here, send your bot a
# message, then get your chat id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email via any SMTP server (e.g. Gmail with an app password: smtp.gmail.com, 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# --- When hosted on a server (example: https://trade.example.com) -------------------
# HOST=127.0.0.1
# COOKIE_SECURE=true
# TRUST_PROXY=true
# CORS_ORIGINS=["https://trade.example.com"]
# FRONTEND_URL=https://trade.example.com
# FYERS_REDIRECT_URI=https://trade.example.com/api/auth/fyers/callback
# (and set the same redirect URL on your Fyers app)
